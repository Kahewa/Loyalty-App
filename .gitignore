# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
functions/node_modules/
*-debug.log

# --- Secrets and generated config -------------------------------------------
# .env holds your Firebase keys; .env.example is the template that stays in the repo.
.env
.env.*
!.env.example

# Generated from .env by scripts/gen-public-config.js, and regenerated by the
# hosting predeploy hook. Not tracked, so the repo carries no project keys.
public/firebase-config.js
