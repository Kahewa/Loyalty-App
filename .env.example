# Copy this file to .env and paste in the values from
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
#
# These keys are PUBLIC by design. They identify your project; they do not grant
# access to anything. firestore.rules is what keeps other people's data out.
# Anything prefixed EXPO_PUBLIC_ is baked into the app bundle at build time.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Where the customer signup page lives. Defaults to https://<project-id>.web.app
# if you leave it blank. Set it if you attach a custom domain.
EXPO_PUBLIC_JOIN_BASE_URL=

# --- Local development only -------------------------------------------------
# Set to 1 to point the app at the Firebase Emulator Suite instead of live data.
EXPO_PUBLIC_USE_EMULATORS=0

# Only needed when testing on a physical phone against the emulators: your PC's
# LAN IP, e.g. 192.168.1.24 (run `ipconfig` to find it).
EXPO_PUBLIC_EMULATOR_HOST=
